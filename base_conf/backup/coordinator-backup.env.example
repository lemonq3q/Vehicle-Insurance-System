# 添加到维护后端当前使用的.env，程序直接读取，无需source或修改启动脚本。
# 必填：开启备份，并指定真实存在且运行用户可读的MySQL连接文件。
MAINTENANCE_BACKUP_ENABLED=true
MAINTENANCE_BACKUP_DEFAULTS_FILE=/etc/vehicle-insurance/mysql-backup.cnf

# 可选：以下是默认值，根据实际部署修改。
MAINTENANCE_BACKUP_MONITOR_URL=http://localhost:8083
MAINTENANCE_BACKUP_ROOT=/var/data/MaintenanceCoordinator/mysql-backup
MAINTENANCE_BACKUP_DATABASE=insurance_saas
MAINTENANCE_BACKUP_MYSQL=mysql
MAINTENANCE_BACKUP_MYSQLDUMP=mysqldump
MAINTENANCE_BACKUP_MYSQLBINLOG=mysqlbinlog
MAINTENANCE_BACKUP_SOURCE_DATA_OPTION=--source-data=2
MAINTENANCE_BACKUP_TIMEOUT_SECONDS=1800
MAINTENANCE_BACKUP_RETENTION_DAYS=30
MAINTENANCE_BACKUP_BINLOG_INTERVAL_MS=300000

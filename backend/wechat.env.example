# 先审阅执行 backend/db/migration/V20261016_01_wechat_login.sql，再配置并启用。
# 两个后端使用同一个网站应用；真实密钥只写服务器环境，不提交仓库。
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 两端可共用此环境文件；内部 callback-uri 分别读取以下变量，不会互相覆盖。
PORTAL_WECHAT_REDIRECT_URI=https://www.idatag.com/saas/wechat/callback
INSURANCE_WECHAT_REDIRECT_URI=https://www.idatag.com/insurance/wechat/callback

# 仅 SaaS 接收安全模式消息：Token 与 43 字符 EncodingAESKey 必须和开放平台后台一致。
WECHAT_MESSAGE_TOKEN=
WECHAT_ENCODING_AES_KEY=

# 沿用现有 SSO 共享密钥和内部服务地址；两端密钥必须相同，勿覆盖已有正确配置。
INSURANCE_SSO_CLIENT_SECRET=
INSURANCE_LOGOUT_USER_URL=http://127.0.0.1:8080/internal/session/logout-user

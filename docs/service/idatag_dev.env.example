# Copy to /usr/idatag_dev/.env on 47.100.210.159, then fill test credentials.
# This is a systemd EnvironmentFile: no "export", shell substitution, or shared production .env.
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
SPRING_DATASOURCE_USERNAME=your_dev_database_user
SPRING_DATASOURCE_PASSWORD=replace_with_dev_database_password
SPRING_DATASOURCE_DRUID_USERNAME=your_dev_database_user
SPRING_DATASOURCE_DRUID_PASSWORD=replace_with_dev_database_password

# Use an unused Redis database for this environment; retain the applications' own key prefixes.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
DEV_REDIS_DATABASE=1

# No shared SERVER_PORT: the JAR defaults are insurance=8080, SaaS=8081.
# These match docs/nginx/lmy.idatag.com on the separate test server.
MAINTENANCE_COORDINATOR_PORT=8082
MONITOR_BACKEND_PORT=8083

MAINTENANCE_INTERNAL_SECRET=replace_with_dev_only_maintenance_secret
INSURANCE_SSO_CLIENT_SECRET=replace_with_dev_only_sso_secret

INSURANCE_FRONTEND_URL=https://lmy.idatag.com/insurance
PORTAL_FRONTEND_URL=https://lmy.idatag.com/saas
PORTAL_WECHAT_REDIRECT_URI=https://lmy.idatag.com/saas/wechat/callback
INSURANCE_WECHAT_REDIRECT_URI=https://lmy.idatag.com/insurance/wechat/callback
VISITOR_LEAD_ALLOWED_ORIGINS=https://lmy.idatag.com

# Internal service calls stay on this test server, not on www.idatag.com.
SAAS_SSO_EXCHANGE_URL=http://127.0.0.1:8081/internal/sso/exchange
SAAS_PORTAL_AUTHORIZE_URL=http://127.0.0.1:8081/internal/sso/portal-authorize
INSURANCE_LOGOUT_ENTERPRISE_URL=http://127.0.0.1:8080/internal/session/logout-enterprise
INSURANCE_LOGOUT_USER_URL=http://127.0.0.1:8080/internal/session/logout-user
INSURANCE_ENTERPRISE_PURGE_URL=http://127.0.0.1:8080/internal/maintenance/enterprise-data/purge
SAAS_MAINTENANCE_BASE_URL=http://127.0.0.1:8081
INSURANCE_MAINTENANCE_BASE_URL=http://127.0.0.1:8080
MONITOR_MAINTENANCE_BASE_URL=http://127.0.0.1:8083
MONITOR_REMINDER_MERGE_URL=http://127.0.0.1:8083/internal/reminders/merge
MONITOR_REMINDER_DELETE_URL=http://127.0.0.1:8083/internal/reminders/delete

WECHAT_ENABLED=false
STRIPE_ENABLED=false
STRIPE_RECHARGE_RETURN_URL=https://lmy.idatag.com/saas/portal/finance/recharges/{orderId}?payment_return=1


# Required for OSS attachment access and Alibaba Cloud OCR; fill valid credentials before deployment.
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=

# Email verification and password reset: choose qq or gmail; fill the selected provider credentials.
EMAIL_PROVIDER=qq
QQ_EMAIL_USER=
QQ_EMAIL_AUTH_CODE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# Optional: required only when WECHAT_ENABLED=true.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MESSAGE_TOKEN=
WECHAT_ENCODING_AES_KEY=

# Optional: use test credentials only when STRIPE_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: only needed to bootstrap a monitor database without existing users.
MONITOR_INITIAL_ADMIN_USERNAME=
MONITOR_INITIAL_ADMIN_PASSWORD=
MONITOR_INITIAL_ADMIN_REAL_NAME=

# Test renewal cadence: 1 month per cycle; omit or set 12 for the normal annual cadence.
RENEWAL_CYCLE_MONTHS=1

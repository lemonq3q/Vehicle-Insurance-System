/.codex/
/.agent/
/.codex-template-work/

# Local tools, dependencies and build output across all subprojects.
/.agents/
**/target/
**/node_modules/
**/dist/
**/dist-dev/
**/.idea/
**/.vscode/

# Python migration helpers generate these caches locally.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local environment overrides; keep configuration examples versioned.
.env
.env.*
!.env.example
!.env.sample
!.env.template
# Public frontend deployment profiles contain no credentials.
!frontend/.env.dev
!systemportal/.env.dev
!monitor-frontend/.env.dev
!frontend/.env.development
!frontend/.env.production
!systemportal/.env.development
!systemportal/.env.production
!monitor-frontend/.env.development
!monitor-frontend/.env.production
*.log
.DS_Store
Thumbs.db

# Generated reports, database backups and verification snapshots.
# Application templates and maintained scripts live outside these directories.
/outputs/
/backups/

# Full database exports contain business data; retain schema and migration SQL.
/base_conf/database/*_full.sql
/base_conf/database/*_full_*.sql
/base_conf/database/*_backup.sql
/docs/db/*_full.sql
/docs/db/*_full_*.sql
/docs/db/*_backup.sql
